import csv

class Student:
    def __init__(self,id,fristName,lastName):
        self.id = id
        self.fristName = fristName
        self.lastName = lastName
        self.grades = []

    def addGrade(self,grade):
        self.grades.append(grade)

    def getAverage(self):
        if not self.grades:
            return 0
        return sum(self.grades) / len(self.grades)

    def display(self):
        average = self.getAverage()
        print(f'id: {self.id}\nName: {self.fristName} {self.lastName}\nAverage: {average:.2f}\n')

