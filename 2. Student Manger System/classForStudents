class GradingSystem:
    def __init__(self):
        self.students = []

    def addStudents(self, student):
        self.students.append(student)
    
    def displayAll(self):
        for student in self.students:
            student.display()  

    def saveToFile(self):
        try:
            with open ("StudentList.csv", "w") as f:
                for student in self.students:
                    line = (
                        student.id + "," +
                        student.fristName + ',' +
                        student.lastName+ ','+
                        str(student.grades)
                    )
                    f.write(line + '\n')
        except FileNotFoundError:
            print('File Not Found')

            
system = GradingSystem()
system.addStudents(s1)
system.addStudents(s2)
system.displayAll()
system.saveToFile()